<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  收件守护：常驻监听 Telegram，收到即分派（v4 的唯一输入入口）。

  KeepAlive：进程退出就重启，保证"随时发一句都有人接"。
  ThrottleInterval 防止异常时疯狂重启（例如配置缺失导致立刻退出）。

  首次启动前建议先跑一次 `daemon.py —drain`：
  它会把积压的历史消息消费掉并把 offset 定在"最新之后"，
  否则几天前发过的消息会被当成新输入重新记一遍。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.carlapple2025.pdca.daemon</string>

	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__PROJECT__/src/daemon.py</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__PROJECT__</string>

	<!-- KeepAlive 用**字典**写法而不是 <true/>：
	     <true/> 的语义是"非正常退出就重启"，若进程成功退出（返回 0）
	     launchd 就认为"任务完成了"，不再拉起 —— 实测踩到：
	     收到 SIGTERM 后守护正常退出，launchd 从此不管它，
	     表现是"已加载"但 state = SIGTERMed、没有活进程。
	     字典写法明确"崩溃就重启"，语义无歧义。 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<!-- 异常退出后至少等 10 秒再重启，避免疯狂循环 -->
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>__PROJECT__/logs/daemon.out.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT__/logs/daemon.err.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
