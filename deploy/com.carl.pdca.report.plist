<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  每天 21:30 日报（v4）。

  读三处 Apple 应用的**当前状态**并汇总：
    提醒事项 → 今天完成/未完成
    日历     → 明天的日程
    备忘录   → 放久了还没处理的备忘（防遗忘）

  **只读**：日报不改任何东西。"某条还在不在"由 journal 台账回答，
  所以连备忘录正文都不用读。

  两个通道都发（Telegram + Bark）互为冗余：日报是关键产物，
  送达不该依赖单一通道。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.carl.pdca.report</string>

	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__PROJECT__/src/report.py</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__PROJECT__</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>__PROJECT__/logs/report.out.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT__/logs/report.err.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
