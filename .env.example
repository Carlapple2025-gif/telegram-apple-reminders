# pdca 本地配置。复制为 .env 并填入真实值。
#
#   cp .env.example .env && chmod 600 .env
#
# .env 已被 .gitignore 排除，不会进版本库。

# Telegram：独立的 pdca 专用 bot（不与其它项目共用）
# 找 @BotFather 发 /newbot 创建，把 token 填这里
TELEGRAM_BOT_TOKEN=

# 你的 chat_id：先给 bot 发一条消息，再运行
#   python3 src/telegram.py whoami
# 它会自动查出来并告诉你怎么填
TELEGRAM_CHAT_ID=

# 可选：Bark（强提醒通道）。填了就用自己的 key。
BARK_KEY=

# 可选：不想再存一份 Bark key？指向别处已配好的 .env —— 项目**读**它、不复制。
#   BARK_UPSTREAM_ENV=/path/to/other-project/.env    （读里面的 NOTIFY_BARK_KEY）
BARK_UPSTREAM_ENV=

# 可选但**强烈建议**：外部心跳（Healthchecks 一类服务）的 ping URL。
#
# 为什么需要它：Telegram / Bark 只能证明"日报送到了"，证明不了"日报跑了"。
# 机器睡过 21:30、launchd 任务被清掉、脚本在推送前就崩了 —— 这三种情况
# 在本机**全都看不出来**（`launchctl print` 的计数还会因 reload 归零）。
# 唯一的办法是让机器之外的东西盯着：跑完就 ping 一下，到点没收到就告警。
#
# 怎么配（healthchecks.io 免费档够用，20 个任务）：
#   1. 注册后建一个 check，Schedule 选 Cron，填  30 21 * * *
#      （与 deploy/com.carl.pdca.report.plist 的 21:30 一致；
#        再设一个 Grace Time，比如 1 小时，机器补跑就不会误报）
#   2. 把它的 ping URL 粘到这里，形如：
#        HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   3. 在 check 的 Integrations 里接上 Telegram（@HealthchecksBot）
#   4. 验证：python3 src/notify.py --heartbeat ok    # 应回 200
#
# 行为：日报**完整送达**→ ping 主 URL；**数据不全或全通道失败**→ ping /fail；
#      `--no-push` 只看内容时**不发**心跳（否则手工预览会伪造"今天跑过了"）。
# 隐私：心跳只送计数摘要（如"完成2 未完成3"），**不送日报正文**。
HEALTHCHECK_URL=

# ── 周报的心跳（可选，**必须与日报分开**）
#
# ⚠️ 不能让周报去 ping 上面那个 URL：远端监控唯一能发现"根本没跑"的手段
# 就是"到点没收到 ping"；周报周日 20:00 ping 一次，就会被当成
# "日报这一趟跑过了" —— 而它盯的 21:30 那一趟反而没人看着。
# 所以周报**只认**下面这个变量，就算配了上面那个也不会退回去用它。
#
# 怎么配：照上面同样步骤再建一个 check，Schedule 填  0 20 * * 0
#        （周日 20:00，与 deploy/com.carl.pdca.weekly.plist 一致）。
# 不配也可以：周报没跑只是少一份回顾，本机 logs/weekly.err.log 与退出码仍在。
WEEKLY_HEALTHCHECK_URL=
